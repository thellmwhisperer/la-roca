{
  "schema": 2,
  "databases": [
    {
      "plugin": "roca-corpus",
      "database": "corpus",
      "path": "roca-corpus.db",
      "alias": "plugin_roca_corpus",
      "tables": [
        {
          "name": "sessions",
          "id_column": "session_id",
          "text_columns": [
            "title",
            "project"
          ],
          "time_columns": [
            "started_at"
          ],
          "columns": [
            "session_id",
            "source_agent",
            "project",
            "started_at",
            "ended_at",
            "duration_minutes",
            "title",
            "metadata",
            "source_surface",
            "machine"
          ]
        },
        {
          "name": "memories",
          "id_column": "id",
          "text_columns": [
            "content"
          ],
          "time_columns": [
            "created_at"
          ],
          "time_join": {
            "table": "sessions",
            "local_column": "source_session",
            "foreign_column": "session_id",
            "time_columns": [
              "started_at"
            ]
          },
          "columns": [
            "id",
            "layer",
            "content",
            "metadata",
            "origin",
            "provenance",
            "source_agent",
            "source_model",
            "source_surface",
            "source_session",
            "source_sequence",
            "project",
            "status",
            "supersedes",
            "created_at"
          ]
        },
        {
          "name": "exchanges",
          "id_column": "id",
          "text_columns": [
            "human_text",
            "agent_text"
          ],
          "time_columns": [
            "agent_timestamp",
            "human_timestamp"
          ],
          "time_join": {
            "table": "sessions",
            "local_column": "session_id",
            "foreign_column": "session_id",
            "time_columns": [
              "started_at"
            ]
          },
          "columns": [
            "id",
            "session_id",
            "exchange_number",
            "is_after_compaction",
            "human_text",
            "agent_text",
            "human_timestamp",
            "agent_timestamp",
            "response_latency_ms",
            "model",
            "provider",
            "tokens_in",
            "tokens_out",
            "tokens_reasoning",
            "cost_usd",
            "machine"
          ]
        },
        {
          "name": "thinking_blocks",
          "id_column": "id",
          "text_columns": [
            "full_text"
          ],
          "time_join": {
            "table": "sessions",
            "local_column": "session_id",
            "foreign_column": "session_id",
            "time_columns": [
              "started_at"
            ]
          },
          "columns": [
            "id",
            "session_id",
            "exchange_number",
            "position_in_session",
            "depth",
            "caution_ratio",
            "word_count",
            "is_after_compaction",
            "full_text",
            "machine"
          ]
        }
      ]
    },
    {
      "plugin": "roca-ops",
      "database": "ops",
      "path": "roca-ops.db",
      "alias": "plugin_roca_ops",
      "tables": [
        {
          "name": "memories",
          "id_column": "id",
          "text_columns": [
            "content"
          ],
          "time_columns": [
            "created_at"
          ],
          "columns": [
            "id",
            "layer",
            "content",
            "metadata",
            "origin",
            "source_agent",
            "source_model",
            "source_surface",
            "source_session",
            "source_sequence",
            "project",
            "status",
            "supersedes",
            "created_at",
            "expires_at"
          ]
        }
      ]
    }
